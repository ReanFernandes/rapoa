    "version": "0.2.0",
    "configurations": [
        {
            "name": "PDB: test descriptor observations",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/test_descriptor.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "python": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "--model",
                "openai/gpt-oss-20b",
                "--steps",
                "10"
            ]
        },
        {
            "name": "PDB : Run With descriptor : GPT oss",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/run_with_descriptor.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "python": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "--model",
                "openai/gpt-oss-20b",
                "--episodes",
                "5"
            ]
        }
    ]
}